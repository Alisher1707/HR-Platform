# Server
NODE_ENV=development
PORT=5000
FRONTEND_URL=http://localhost:5173

# Database — never use a short/guessable password, even locally
# (docker-compose.yml requires POSTGRES_PASSWORD to be set, no default)
POSTGRES_PASSWORD=change_me_generate_with_openssl_rand_base64_18
DATABASE_URL=postgresql://postgres:change_me_generate_with_openssl_rand_base64_18@localhost:5432/hr_platform
# XAVFSIZLIK-AUDIT.md P-6 — docker-compose.yml now provisions a
# self-signed cert for Postgres automatically (see the `pg-certs`
# service), so DB_SSL=true works out of the box with `docker compose up`.
# REJECT_UNAUTHORIZED=false because that cert isn't CA-signed — this
# still encrypts the wire, it just doesn't do full PKI trust (fine for
# same-host/same-network; use a real CA cert + true if you ever split
# backend and Postgres across separate hosts).
DB_SSL=true
DB_SSL_REJECT_UNAUTHORIZED=false

# JWT — generate with: openssl rand -hex 32
# NEVER reuse the same value between dev and prod, and never commit real ones.
JWT_ACCESS_SECRET=your_access_secret_min_32_chars_change_this_in_production
JWT_REFRESH_SECRET=your_refresh_secret_min_32_chars_change_this_in_production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Invite
INVITE_TOKEN_EXPIRES_DAYS=7

# Telegram bot (optional — bot features no-op if unset)
TELEGRAM_BOT_TOKEN=
TELEGRAM_BOT_USERNAME=
# generate with: openssl rand -hex 24
TELEGRAM_WEBHOOK_SECRET=
TELEGRAM_WEBHOOK_BASE_URL=

# Only used by `pnpm run seed` (initial SUPER_ADMIN/HR accounts) — required,
# no default, must be >= 12 chars. See src/db/seed.js.
SEED_ADMIN_EMAIL=admin@hrplatform.com
SEED_ADMIN_PASSWORD=
SEED_HR_EMAIL=hr@hrplatform.com
SEED_HR_PASSWORD=
